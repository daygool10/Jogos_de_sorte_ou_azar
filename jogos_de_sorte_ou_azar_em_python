
from abc import ABC, abstractmethod
import random

class Jogo(ABC):

  def __init__(self):
    self._aposta = 0
    self._resultado = 0

  def set_aposta(self, aposta):
    self._aposta = aposta

  def set_resultado(self, resultado):
    self._resultado = resultado

  @abstractmethod

  def joga_jogo(self):
    pass

  def mostra_resultado(self):
    print(f'Aposta: {self._aposta}')
    print(f'Resultado: {self._resultado}')

    if self._aposta == self._resultado:
      print('Você venceu!')
    else:
      print('Tente novamente...')

class Dado(Jogo):
  def set_aposta(self, aposta):
    if aposta > 6 or aposta < 1:
      print('Valor inválido para o dado!')
    else:
      super().set_aposta(aposta)


  def set_resultado(self, resultado):
    print('Não pode roubar no dado...')

  def joga_jogo(self):
    resultado = random.randint(1, 6)

    super().set_resultado(resultado)

class Roleta(Jogo):

  def set_aposta(self, aposta):
    if aposta > 36 or aposta < 1:
      print('Valor inválido para a roleta!')
    else:
      super().set_aposta(aposta)


  def set_resultado(self, resultado):
    print('Não pode roubar na roleta!')

  def joga_jogo(self):
    resultado = random.randint(1, 36)

    super().set_resultado(resultado)

d1 = Dado()
r1 = Roleta()

r1.joga_jogo()
r1.set_aposta(15)
r1.mostra_resultado()
