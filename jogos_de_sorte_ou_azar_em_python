        "from abc import ABC, abstractmethod\n",
        "import random\n",
        "\n",
        "class Jogo(ABC):\n",
        "\n",
        "  def __init__(self):\n",
        "    self._aposta = 0\n",
        "    self._resultado = 0\n",
        "\n",
        "  def set_aposta(self, aposta):\n",
        "    self._aposta = aposta\n",
        "\n",
        "  def set_resultado(self, resultado):\n",
        "    self._resultado = resultado\n",
        "\n",
        "  @abstractmethod\n",
        "\n",
        "  def joga_jogo(self):\n",
        "    pass\n",
        "\n",
        "  def mostra_resultado(self):\n",
        "    print(f'Aposta: {self._aposta}')\n",
        "    print(f'Resultado: {self._resultado}')\n",
        "\n",
        "    if self._aposta == self._resultado:\n",
        "      print('Você venceu!')\n",
        "    else:\n",
        "      print('Tente novamente...')\n",
        "\n"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "class Dado(Jogo):\n",
        "  def set_aposta(self, aposta):\n",
        "    if aposta > 6 or aposta < 1:\n",
        "      print('Valor inválido para o dado!')\n",
        "    else:\n",
        "      super().set_aposta(aposta)\n",
        "\n",
        "\n",
        "  def set_resultado(self, resultado):\n",
        "    print('Não pode roubar no dado...')\n",
        "\n",
        "  def joga_jogo(self):\n",
        "    resultado = random.randit(1, 6)\n",
        "\n",
        "    super().set_resultado(resultado)"
      ],
      "metadata": {
